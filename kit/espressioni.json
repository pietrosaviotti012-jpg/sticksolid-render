{
  "_": "Le 12 espressioni di StickSolid. stick = opzioni di drawStick (face + extra), solid = opzioni di setFace (eyes 1.35 sempre). quando = in che momento del video.",
  "sorriso":     { "quando": "di base, presentazioni, chiusura",
                   "stick": { "face": { "eyes": "normal", "mouth": "smile" } },
                   "solid": { "brow": 0.6, "tilt": 0.7, "lid": 0.8, "mouth": "smile" } },
  "risata":      { "quando": "la battuta, la sorpresa buffa",
                   "stick": { "face": { "eyes": "happy", "mouth": "grin" }, "blush": true },
                   "solid": { "brow": 0.9, "tilt": 0.8, "lid": 0.15, "mouth": "smile", "grin": 1.2 } },
  "whoa":        { "quando": "il colpo di scena, il \"But\"",
                   "stick": { "face": { "eyes": "wide", "mouth": "o", "browUp": 1 } },
                   "solid": { "brow": 1, "tilt": 0.8, "lid": 1, "open": 0.8 } },
  "paura":       { "quando": "il pericolo vicino, l'impatto",
                   "stick": { "face": { "eyes": "wide", "mouth": "teeth", "browUp": 0.6, "browAng": 0.4, "look": [-0.5, 0] }, "sweat": true },
                   "solid": { "brow": 1, "tilt": 1.6, "lid": 1, "open": 0.3, "look": [-0.6, 0] } },
  "dubbio":      { "quando": "\"some people think…\", le leggende",
                   "stick": { "face": { "eyes": "half", "mouth": "flat", "browOne": 1, "look": [0.5, -0.3] } },
                   "solid": { "brow": 0.2, "tilt": 0, "lid": 0.3, "mouth": "flat", "one": 1, "look": [0.5, -0.3] } },
  "pensieroso":  { "quando": "la domanda, il ragionamento",
                   "stick": { "face": { "eyes": "normal", "mouth": "flat", "browOne": -1, "look": [-0.7, -0.8] } },
                   "solid": { "brow": 0.4, "tilt": 0.3, "lid": 0.5, "mouth": "flat", "one": -1, "look": [-0.8, -0.8] } },
  "preoccupato": { "quando": "il disastro che arriva",
                   "stick": { "face": { "eyes": "normal", "mouth": "frown", "browAng": 0.35, "look": [0, 0.3] } },
                   "solid": { "brow": 0.4, "tilt": 1.5, "lid": 0.7, "mouth": "flat", "look": [0, 0.3] } },
  "triste":      { "quando": "le vittime, il finale amaro",
                   "stick": { "face": { "eyes": "normal", "mouth": "frown", "browAng": 0.55, "look": [0, 0.8] } },
                   "solid": { "brow": 0.2, "tilt": 1.7, "lid": -0.2, "mouth": "frown", "look": [0, 0.7] } },
  "furbo":       { "quando": "il trucco, l'inganno, \"ecco perché\"",
                   "stick": { "face": { "eyes": "smug", "mouth": "smirk", "browAng": -0.2, "look": [0.5, 0] } },
                   "solid": { "brow": 0.3, "tilt": -0.5, "lid": -0.3, "mouth": "smirk", "look": [0.6, 0] } },
  "arrabbiato":  { "quando": "il cattivo, l'ingiustizia",
                   "stick": { "face": { "eyes": "normal", "mouth": "teeth", "browAng": -0.5, "pupil": 0.35 } },
                   "solid": { "brow": -0.4, "tilt": -1.5, "lid": 0.4, "mouth": "frown" } },
  "confuso":     { "quando": "il fatto che non torna",
                   "stick": { "face": { "eyesL": "wide", "eyes": "normal", "mouth": "smirk", "browOne": 1, "look": [0.3, -0.4] } },
                   "solid": { "brow": 0.6, "tilt": 0.4, "lid": 0.8, "one": 1, "mouth": "smirk", "look": [0.4, -0.5] } },
  "stanco":      { "quando": "l'attesa lunga, la notte, la noia",
                   "stick": { "face": { "eyes": "half", "blink": 0.45, "mouth": "flat", "browAng": 0.15, "look": [0, 0.4] } },
                   "solid": { "brow": 0, "tilt": 0.5, "lid": -0.8, "mouth": "flat", "look": [0, 0.4] } }
}
